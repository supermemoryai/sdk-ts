{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node"],
    "paths": {
      "supermemory": ["../../src/index.ts"],
      "supermemory/*": ["../../src/*", "../../src/*/index.ts"]
    }
  },
  "include": ["snippets/*.ts"]
}
