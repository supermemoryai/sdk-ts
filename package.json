{
  "name": "supermemory",
  "version": "5.0.0-rc.6",
  "description": "The official TypeScript library for the Supermemory API",
  "license": "Apache-2.0",
  "author": "Supermemory <dhravya@supermemory.com>",
  "homepage": "https://supermemory.ai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/supermemoryai/sdk-ts.git"
  },
  "bin": {
    "supermemory": "bin/cli.mjs"
  },
  "type": "module",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/cjs/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./package.json": "./package.json",
    "./types": {
      "import": {
        "types": "./dist/esm/types/index.d.ts",
        "default": "./dist/esm/types/index.js"
      },
      "require": {
        "types": "./dist/cjs/types/index.d.ts",
        "default": "./dist/cjs/types/index.js"
      }
    },
    "./models/errors": {
      "import": {
        "types": "./dist/esm/models/errors/index.d.ts",
        "default": "./dist/esm/models/errors/index.js"
      },
      "require": {
        "types": "./dist/cjs/models/errors/index.d.ts",
        "default": "./dist/cjs/models/errors/index.js"
      }
    },
    "./models": {
      "import": {
        "types": "./dist/esm/models/index.d.ts",
        "default": "./dist/esm/models/index.js"
      },
      "require": {
        "types": "./dist/cjs/models/index.d.ts",
        "default": "./dist/cjs/models/index.js"
      }
    },
    "./models/operations": {
      "import": {
        "types": "./dist/esm/models/operations/index.d.ts",
        "default": "./dist/esm/models/operations/index.js"
      },
      "require": {
        "types": "./dist/cjs/models/operations/index.d.ts",
        "default": "./dist/cjs/models/operations/index.js"
      }
    },
    "./*.js": {
      "import": {
        "types": "./dist/esm/*.d.ts",
        "default": "./dist/esm/*.js"
      },
      "require": {
        "types": "./dist/cjs/*.d.ts",
        "default": "./dist/cjs/*.js"
      }
    },
    "./*": {
      "import": {
        "types": "./dist/esm/*.d.ts",
        "default": "./dist/esm/*.js"
      },
      "require": {
        "types": "./dist/cjs/*.d.ts",
        "default": "./dist/cjs/*.js"
      }
    }
  },
  "files": [
    "dist",
    "bin",
    "MIGRATION.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "generate": "bun scripts/generate.ts",
    "build": "rm -rf dist && tsc -p tsconfig.json && tsc -p tsconfig.cjs.json && bun scripts/cjs-package.ts",
    "check-types": "tsc --noEmit -p tsconfig.json && tsc -p tests/rc5-compat/tsconfig.types.json && bun tests/rc5-compat/check-snippets.ts && bun tests/check-docs.ts",
    "test": "bun test",
    "prepublishOnly": "bun run build",
    "generate:surface": "SURFACE_ONLY=1 bun scripts/generate.ts"
  },
  "devDependencies": {
    "@types/bun": "^1.2.0",
    "@types/node": "22",
    "dotenv": "^18.0.5",
    "supermemory-rc5": "npm:supermemory@5.0.0-rc.5",
    "typescript": "~5.9.3",
    "undici": "^8.11.2"
  },
  "dependencies": {
    "zod": "^3.25.65 || ^4.0.0"
  },
  "typesVersions": {
    "*": {
      "dist/*": [
        "./dist/*"
      ],
      "models": [
        "./dist/cjs/models/index.d.ts"
      ],
      "models/errors": [
        "./dist/cjs/models/errors/index.d.ts"
      ],
      "models/operations": [
        "./dist/cjs/models/operations/index.d.ts"
      ],
      "types": [
        "./dist/cjs/types/index.d.ts"
      ],
      "*": [
        "./dist/cjs/*",
        "./dist/cjs/*/index.d.ts"
      ]
    }
  }
}
