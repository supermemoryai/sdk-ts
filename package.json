{
  "name": "supermemory",
  "version": "5.0.0-rc.6",
  "description": "The official TypeScript library for the Supermemory API",
  "license": "Apache-2.0",
  "author": "Supermemory <dhravya@supermemory.com>",
  "homepage": "https://supermemory.ai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/supermemoryai/sdk-ts.git"
  },
  "bin": {
    "supermemory": "bin/cli.mjs"
  },
  "type": "module",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/cjs/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "bin",
    "MIGRATION.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "generate": "bun scripts/generate.ts",
    "build": "rm -rf dist && tsc -p tsconfig.json && tsc -p tsconfig.cjs.json && bun scripts/cjs-package.ts",
    "check-types": "tsc --noEmit -p tsconfig.json && bun tests/check-docs.ts",
    "test": "bun test",
    "prepublishOnly": "bun run build"
  },
  "devDependencies": {
    "@types/bun": "^1.2.0",
    "@types/node": "22",
    "dotenv": "^18.0.5",
    "typescript": "~5.9.3",
    "undici": "^8.11.2"
  }
}
